PORT=9090
DATA_DIR=./data
DATABASE_URL=sqlite://./data/nimbus.db
# JWT_SECRET is optional — auto-created in ./data/jwt.secret if missing
JWT_TTL_HOURS=72

# Optional override — otherwise auto-created in ./data/access.secret
# Required on every API call as header: X-Nimbus-Access (unless NIMBUS_PUBLIC=true)
# NIMBUS_ACCESS_SECRET=

# Keep the access-key gate enabled for internet-facing deployments.
# Set true only if the deployment is intentionally public and the reverse proxy provides
# additional protection/rate limiting for the login and setup endpoints.
NIMBUS_PUBLIC=false

# Programmatic storage API (upload/import/download from your apps). Auto-created in ./data/api.key if unset.
# Send as header: X-Nimbus-Key (or Authorization: Bearer <key>). Upload/import responses include a public url.
# NIMBUS_API_KEY=

# Set on the server (not in the browser) so users skip API setup:
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

CHUNK_SIZE=8388608
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5199,http://127.0.0.1:5199

# Self-hosted Telegram Bot API storage backend (alternative to MTProto).
# When TELEGRAM_BOT_API_URL is set, file storage uses HTTP Bot API instead of MTProto.
# Requires a running self-hosted Bot API server (e.g., tdlib/telegram-bot-api).
# TELEGRAM_BOT_API_URL=http://localhost:8081
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_STORAGE_CHAT_ID=
# TELEGRAM_BOT_CHUNK_SIZE=8388608


# Optional Cobalt API fallback when native extractors fail (TikTok WAF, etc.)
# Must be an API host that accepts POST / with Accept: application/json
# (frontend-only hosts like https://cobalt.canine.tools reject POST with 405).
# Self-host: https://github.com/imputnet/cobalt
# NIMBUS_COBALT_API=https://your-cobalt-api.example
# NIMBUS_COBALT_API_KEY=

# Optional VidBee API fallback (yt-dlp, 1000+ sites) — runs after Cobalt.
# Self-host: https://github.com/nexmoe/VidBee (docker compose up api)
# NIMBUS_VIDBEE_API=http://localhost:3100
# Must point at the same folder VidBee writes to (VIDBEE_DOWNLOAD_DIR in VidBee).
# NIMBUS_VIDBEE_DOWNLOAD_DIR=./data/vidbee-downloads

# Optional direct local yt-dlp fallback (runs after native, Cobalt, and VidBee).
# Docker image includes yt-dlp; bare-metal installs can set NIMBUS_YTDLP_PATH.
# NIMBUS_YTDLP_PATH=yt-dlp
# NIMBUS_YTDLP_DISABLED=false
# NIMBUS_YTDLP_ALLOW_PLAYLIST=false
# NIMBUS_YTDLP_MAX_DOWNLOADS=50

# Optional official OAuth account connections for Settings -> Connected media accounts.
# You can also configure this in the UI. Without developer accounts, use the
# Settings -> Connect browser session cookies.txt path instead.
# Use the public HTTPS URL that reaches this server, not the private LAN IP.
# Register these callbacks in the provider developer consoles:
#   https://your-domain.example/api/v1/social/oauth/tiktok/callback
#   https://your-domain.example/api/v1/social/oauth/instagram/callback
#   https://your-domain.example/api/v1/social/oauth/facebook/callback
# NIMBUS_PUBLIC_BASE_URL=https://your-domain.example
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# META_APP_ID=
# META_APP_SECRET=

# S3-compatible access to this server's storage (Settings -> S3 Access).
# Other tools (rclone, aws-cli, restic, s3cmd) can PUT/GET files here as if it
# were an S3 bucket. Buckets = top-level drive folders; keys = nested paths.
# Credentials are auto-created in ./data/s3gw.json and shown in Settings.
NIMBUS_S3_ENABLED=false
NIMBUS_S3_PORT=9091
NIMBUS_S3_REGION=us-east-1
