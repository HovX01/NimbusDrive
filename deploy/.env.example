# Keep the VPS behind the access-key gate. Set to true only when the login endpoints
# are intentionally exposed to the internet and protected by a trusted reverse proxy.
NIMBUS_PUBLIC=false
PORT=8080
# Replace with the exact HTTPS origin used by the browser. Do not keep localhost in production.
CORS_ORIGINS=https://nimbus.example.com
# Optional — leave blank to configure in the web UI after deploy:
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# NIMBUS_API_KEY=


# The deploy Compose file forces these paths inside the persistent nimbus-data volume:
# DATA_DIR=/data
# DATABASE_URL=sqlite:///data/nimbus.db
# This preserves /data/telegram.session and /data/nimbus.db across restarts.

# Cobalt fallback (compose also sets this to http://cobalt:9000)
NIMBUS_COBALT_API=http://cobalt:9000
# NIMBUS_COBALT_API_KEY=

# Telegram document chunk size (200 MiB) and parallel uploads.
CHUNK_SIZE=209715200
UPLOAD_WORKERS=2

# Self-hosted Telegram Bot API storage backend (alternative to MTProto).
# TELEGRAM_BOT_API_URL=http://localhost:8081
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_STORAGE_CHAT_ID=
# TELEGRAM_BOT_CHUNK_SIZE=209715200

# Self-backup of /data/nimbus.db to Telegram. Use /app/nimbus backup as the
# Coolify scheduled task command; no headers or auth setup required.
# For a separate task container, set NIMBUS_BACKUP_URL and NIMBUS_BACKUP_SECRET.
NIMBUS_DB_BACKUP_ENABLED=true
NIMBUS_DB_BACKUP_PREFIX=nimbus-db-backup
NIMBUS_DB_BACKUP_KEEP=0
